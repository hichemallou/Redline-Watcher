# Copy to ~/soc-stack.env and fill in.  Never commit this file.

# --- Slack (Socket Mode app) ---
SLACK_BOT_TOKEN="xoxb-..."           # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN="xapp-..."           # Basic Information → App-Level Token (scope connections:write)
SLACK_ALLOWED_USERS="U0123456789"    # Slack member ID (profile → ⋮ → Copy member ID)
SLACK_ALLOWED_CHANNELS="C0123456789" # #soc-alerts channel ID (channel details, at the bottom)

# --- Models ---
MODELS_DIR="/home/dell/hktn"
AGENT_MODEL="Qwen3.8-27B"            # or NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF
# LLAMA_SERVER="/home/dell/llama.cpp/build/bin/llama-server"

# --- Sandbox ---
SANDBOX_NAME="soc-agent"
POLICY_TIER="balanced"               # restricted | balanced | open
LOGS_DIR="/var/log"                  # mounted read-only at /sandbox/logs

# --- Ports ---
LLAMA_PORT=8000          # LLM server (bound to 127.0.0.1; any free port except 11435)
DASHBOARD_PORT=18789     # OpenClaw web dashboard
# NEMOCLAW_GATEWAY_PORT= # OpenShell gateway, only if its default port is already taken